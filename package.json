{
  "name": "clean-record",
  "version": "0.0.0",
  "description": "Grabador de pantalla completa con audio local",
  "author": "Mateo Huancho",
  "main": "electron/main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "desktop:build": "ng build --configuration production --base-href ./",
    "desktop": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-builder --win",
    "desktop:package:dir": "npm run desktop:build && electron-builder --win --dir"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@tailwindcss/postcss": "^4.1.11",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.cleanrecord.desktop",
    "productName": "Clean Record",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/clean-record/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Clean-Record-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
